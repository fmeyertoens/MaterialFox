{
  "name": "materialfox",
  "version": "89.0.0",
  "description": "A userChrome.css theme for Firefox inspired by Material Design",
  "main": "user.js",
  "scripts": {
    "build": "sass src/:chrome/",
    "build:watch": "sass --watch src/:chrome/",
    "dev": "node dev/mf.mjs",
    "test:visual": "npm run build -- --quiet && playwright test",
    "test:visual:update": "npm run build -- --quiet && playwright test --update-snapshots=all",
    "test:visual:report": "playwright show-report",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmeyertoens/MaterialFox.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fmeyertoens/MaterialFox/issues"
  },
  "homepage": "https://github.com/fmeyertoens/MaterialFox#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "sass": "^1.89.2"
  }
}
